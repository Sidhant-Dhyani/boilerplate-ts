NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/boilerplate
JWT_ACCESS_SECRET=change_me_to_a_long_random_access_secret_32+
JWT_REFRESH_SECRET=change_me_to_a_long_random_refresh_secret_32+
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="App Name <noreply@example.com>"
